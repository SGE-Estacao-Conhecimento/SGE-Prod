# Copie para .env privado. Nunca versionar senhas reais.
DB_PORT=3306
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Administrador do MinIO: não usar estas credenciais na API.
MINIO_ROOT_USER=sge_admin
MINIO_ROOT_PASSWORD=

# Conta exclusiva da API, diferente do administrador.
S3_ACCESS_KEY_ID=sge_backend
S3_SECRET_ACCESS_KEY=  # a senha obrigatoriamente precisa de 32 caracteres

# Opcional: fixar imagens por tag/digest validado antes de produção.
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_MC_IMAGE=quay.io/minio/mc:latest

# Endpoint/bucket/região da API são fixos no Compose:
# http://minio:9000 / sge-documentos / us-east-1 / path-style=true
# S3_* ainda precisa ser lido pela implementação C#.
