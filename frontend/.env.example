# Configuracao padrao do frontend conectando ao backend ASP.NET Core (porta 5170).
# Nao utilize IP fixo: em acessos via rede local (LAN), o client.js substitui automaticamente
# localhost pelo IP do computador hospedeiro acessado no navegador (window.location.hostname).
# Para alternar para o modo simulado (standalone), deixe VITE_API_BASE_URL vazio.
VITE_API_BASE_URL=http://localhost:5170
